      <form name="Switching Bidirectional DC-DC Converter model" splitter="60" w="500" h="400" commentlines="4" help-width="490" category-width="180">
        <category name="Base Values and Per-Unit Plant" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="VbatKV" desc="Battery-side DC voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="1E-12" max="1E+308">
            <value><![CDATA[0.4]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Battery-side DC voltage base.]]></help>
          </parameter>
          <parameter name="Vups_dcKV" desc="UPS-side DC voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="-1E+308" max="1E+308">
            <value><![CDATA[0.8]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[UPS-side DC voltage base]]></help>
          </parameter>
          <parameter name="SbaseMVA" desc="Power base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MVA" min="1E-12" max="1E+308">
            <value><![CDATA[1.5]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Power base used for Zbase, Lbase and Cbase conversion.]]></help>
          </parameter>
          <parameter name="freqBase" desc="Base frequency" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value>60.00000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Base frequency; wb = 2*pi*freqBase.]]></help>
          </parameter>
          <parameter name="c_bat_pu" desc="Output capacitance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="1E-12" max="1E+308">
            <value>0.50000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Buck voltage-loop and plant capacitance in per unit.]]></help>
          </parameter>
          <parameter name="l_bat_pu" desc="Converter inductance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="1E-12" max="1E+308">
            <value><![CDATA[0.20000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Converter current-loop and plant inductance in per unit.]]></help>
          </parameter>
        </category>
        <category name="Bandwidth PI Tuning" visible="true" splitter="70">
          <cond><![CDATA[true]]></cond>
          <parameter name="fbw_v_ups" desc="Offine mode voltage-loop bandwidth " type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[20]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target closed-loop bandwidth.]]></help>
          </parameter>
          <parameter name="zt_v_ups" desc="Offline mode voltage-loop damping ratio  " type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target damping ratio.]]></help>
          </parameter>
          <parameter name="fbw_c_bat" desc="Current-loop bandwidth" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[500]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target closed-loop bandwidth.]]></help>
          </parameter>
          <parameter name="zt_c_bat" desc="Current-loop damping ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[0.707]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target damping ratio.]]></help>
          </parameter>
        </category>
        <category name="Control Mode Specification" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="P_ref_pu" desc="Static power setpoint " type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="-1" max="1">
            <value><![CDATA[0.0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Power charged to the battery, used when UPS is in online mode and DC voltage droop control is disabled. ]]></help>
          </parameter>
          <parameter name="Kdroop" desc="Voltage droop coefficient" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu/pu" min="0" max="10">
            <value><![CDATA[0.0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[The corresponding droop coefficient]]></help>
          </parameter>
          <parameter name="ramp_rate_limit" desc="Soft recovery ramp rate limit" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu/s" min="0" max="10">
            <value><![CDATA[0.5]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[The ramp up limit for UPS recovery from battery mode to online mode.]]></help>
          </parameter>
        </category>
      </form>
