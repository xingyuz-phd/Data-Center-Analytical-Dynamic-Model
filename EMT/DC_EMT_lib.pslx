      <form name="Average variable frequency drive model" splitter="60" w="500" h="400" commentlines="4" help-width="490">
        <category name="Base Values and Per-Unit Plant" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="Vg_base" desc="Grid side AC voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="1E-12" max="1E+308">
            <value><![CDATA[0.48000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Line-to-line RMS voltage base used for per-unit conversion.]]></help>
          </parameter>
          <parameter name="Vbase" desc="Load side AC voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="1E-12" max="1E+308">
            <value><![CDATA[0.32000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Line-to-line RMS voltage base used for per-unit conversion.]]></help>
          </parameter>
          <parameter name="Sbase" desc="Power base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MVA" min="1E-12" max="1E+308">
            <value><![CDATA[0.50000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Power base used for per-unit conversion.]]></help>
          </parameter>
          <parameter name="Fbase" desc="Base frequency" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[40.00000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Base frequency; wb = 2*pi*Fbase.]]></help>
          </parameter>
          <parameter name="c_dc_pu" desc="DC-link capacitor" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="pu" min="-1E-308" max="1E+308">
            <value><![CDATA[10]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="wm_pu_ref" desc="Motor speed setpoint" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="p.u." min="0" max="1E+308">
            <value><![CDATA[0.98]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Vmax" desc="Maximum converter voltage " type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[1.2]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="t_init" desc="Initialization time" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[2]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Time to remove the fictitious DC source]]></help>
          </parameter>
        </category>
      </form>
