      <form name="Resistor Load Ramp" splitter="60" w="500" h="400" commentlines="4" help-width="490" category-width="180">
        <category name="Base Values" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="SbaseMVA" desc="Power base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MVA" min="0" max="1E+308">
            <value><![CDATA[0.05000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Power base used to convert per-unit load power.]]></help>
          </parameter>
          <parameter name="VloadKV" desc="Load voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="0" max="1E+308">
            <value><![CDATA[0.04800]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[DC load-side voltage base used to calculate resistance.]]></help>
          </parameter>
        </category>
        <category name="Timing" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="t_start" desc="Ramp start time" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[3.00000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Time at which the resistor-load ramp starts.]]></help>
          </parameter>
        </category>
        <category name="Load Profile" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="Pload_ramp" desc="Maximum ramp load" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.60000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Maximum ramp load in per unit.]]></help>
          </parameter>
          <parameter name="Pload_min" desc="Minimum load" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.10000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Minimum load offset in per unit.]]></help>
          </parameter>
          <parameter name="k_ramp" desc="Ramp rate" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu/s" min="0" max="1E+308">
            <value><![CDATA[2.00000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Ramp-rate coefficient used by the load profile.]]></help>
          </parameter>
        </category>
      </form>
