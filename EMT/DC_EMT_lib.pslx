            <help><![CDATA[Target closed-loop bandwidth.]]></help>
          </parameter>
          <parameter name="zt_c_afe" desc="AFE current-loop damping ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[0.707]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target damping ratio.]]></help>
          </parameter>
          <parameter name="fbw_dc_afe" desc="AFE DC-voltage-loop bandwidth" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[20]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target closed-loop bandwidth.]]></help>
          </parameter>
          <parameter name="zt_dc_afe" desc="AFE DC-voltage-loop damping ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[0.707]]></value>
            <cond><![CDATA[true]]></cond>
