      <form name="Average PFC-PSU model" splitter="60" w="500" h="400" commentlines="4" help-width="490" category-width="180">
        <category name="Base Values and Per-Unit Plant" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="VbaseKV" desc="AC voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="1E-12" max="1E+308">
            <value>0.48000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[RMS AC voltage base used by the existing per-unit conversion.]]></help>
          </parameter>
          <parameter name="VDCKV" desc="DC voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="1E-12" max="1E+308">
            <value>0.80000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[DC-link voltage base used by the existing per-unit conversion.]]></help>
          </parameter>
          <parameter name="SbaseMVA" desc="Power base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MVA" min="1E-12" max="1E+308">
            <value><![CDATA[0.05000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Power base used for Zbase, Lbase and Cbase conversion.]]></help>
          </parameter>
          <parameter name="freqBase" desc="Base frequency" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value>60.00000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Base frequency; wb = 2*pi*freqBase.]]></help>
          </parameter>
          <parameter name="c_dc_pu" desc="DC-link capacitance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="1E-12" max="1E+308">
            <value><![CDATA[10]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Effective DC-link capacitance in per unit.]]></help>
          </parameter>
          <parameter name="l_pfc_pu" desc="PFC filter inductance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="1E-12" max="1E+308">
            <value>0.10000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[PFC current-loop and plant inductance in per unit.]]></help>
          </parameter>
          <parameter name="r_pfc_pu" desc="PFC filter resistance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value>0.00300</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[PFC current-loop and plant resistance in per unit.]]></help>
          </parameter>
        </category>
        <category name="Bandwidth PI Tuning" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="fbw_v_pfc" desc="PFC voltage-loop bandwidth" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[10]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target closed-loop bandwidth.]]></help>
          </parameter>
          <parameter name="zt_v_pfc" desc="PFC voltage-loop damping ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target damping ratio.]]></help>
          </parameter>
          <parameter name="fbw_c_pfc" desc="PFC current-loop bandwidth" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[5000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target closed-loop bandwidth.]]></help>
          </parameter>
          <parameter name="zt_c_pfc" desc="PFC current-loop damping ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[0.707]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target damping ratio.]]></help>
          </parameter>
        </category>
