      <form name="Square Wave Load" splitter="60" w="500" h="400" commentlines="4" help-width="490" category-width="180">
        <category name="Base Values" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="SbaseMVA" desc="Power base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MVA" min="0" max="1E+308">
            <value><![CDATA[0.05000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Power base used to convert per-unit load power.]]></help>
          </parameter>
          <parameter name="VloadKV" desc="Load voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="0" max="1E+308">
            <value><![CDATA[0.04800]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[DC load-side voltage base used to calculate resistance.]]></help>
          </parameter>
        </category>
        <category name="Timing" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="t_base_start" desc="Base-load start time" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[2.00000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Time at which the base load ramp starts.]]></help>
          </parameter>
          <parameter name="t_wave_start" desc="Square-wave start time" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="s" min="0" max="1E+308">
            <value><![CDATA[4.00000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Time at which square-wave modulation becomes active.]]></help>
          </parameter>
        </category>
        <category name="Load Profile" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="f_data" desc="Square-wave frequency" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="0" max="1E+308">
            <value><![CDATA[0.50000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Square-wave load modulation frequency.]]></help>
          </parameter>
          <parameter name="ah_sqr" desc="Square-wave amplitude" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.10000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Square-wave modulation amplitude in per unit.]]></help>
          </parameter>
          <parameter name="DutyRatio" desc="Duty Ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1">
            <value><![CDATA[0.50000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Square-wave duty ratio from 0 to 1.]]></help>
          </parameter>
          <parameter name="Pload_ramp" desc="Base ramp load" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.50000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Base load reached by the start-up ramp.]]></help>
          </parameter>
          <parameter name="Pload_min" desc="Minimum load" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value><![CDATA[0.10000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Minimum load offset in per unit.]]></help>
          </parameter>
        </category>
      </form>
