      <form name="Switching Buck converter model" splitter="60" w="500" h="400" commentlines="4" help-width="490" category-width="180">
        <category name="Base Values and Per-Unit Plant" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="VpsuKV" desc="Input-side voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="1E-12" max="1E+308">
            <value><![CDATA[0.8]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Input-side voltage base]]></help>
          </parameter>
          <parameter name="VloadKV" desc="Load-side voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="1E-12" max="1E+308">
            <value>0.04800</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Load-side DC voltage base.]]></help>
          </parameter>
          <parameter name="SbaseMVA" desc="Power base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MVA" min="1E-12" max="1E+308">
            <value><![CDATA[0.05000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Power base used for Zbase, Lbase and Cbase conversion.]]></help>
          </parameter>
          <parameter name="freqBase" desc="Base frequency" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value>60.00000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Base frequency; wb = 2*pi*freqBase.]]></help>
          </parameter>
          <parameter name="c_dc_pu" desc="Output capacitance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="1E-12" max="1E+308">
            <value><![CDATA[2.5]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Buck voltage-loop and plant capacitance in per unit.]]></help>
          </parameter>
          <parameter name="l_buck_pu" desc="Buck inductance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="1E-12" max="1E+308">
            <value><![CDATA[5.0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Buck current-loop and plant inductance in per unit.]]></help>
          </parameter>
        </category>
        <category name="Bandwidth PI Tuning" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="fbw_v_buck" desc="Buck voltage-loop bandwidth" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[20]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target closed-loop bandwidth.]]></help>
          </parameter>
          <parameter name="zt_v_buck" desc="Buck voltage-loop damping ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target damping ratio.]]></help>
          </parameter>
          <parameter name="fbw_c_buck" desc="Buck current-loop bandwidth" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[500]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target closed-loop bandwidth.]]></help>
          </parameter>
          <parameter name="zt_c_buck" desc="Buck current-loop damping ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[0.707]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target damping ratio.]]></help>
          </parameter>
        </category>
      </form>
