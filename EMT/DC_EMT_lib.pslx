            <help><![CDATA[Line-to-line RMS voltage base used for per-unit conversion.]]></help>
          </parameter>
          <parameter name="vdc_nom" desc="Nominal DC-link voltage" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="1E-12" max="1E+308">
            <value>0.80000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Nominal DC-link voltage used by the controller.]]></help>
          </parameter>
          <parameter name="Sbase" desc="Power base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MVA" min="1E-12" max="1E+308">
            <value><![CDATA[1.50000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Power base used for per-unit conversion.]]></help>
          </parameter>
          <parameter name="Fbase" desc="Base frequency" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value>60.00000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Base frequency; wb = 2*pi*Fbase.]]></help>
          </parameter>
          <parameter name="c_dc_pu" desc="DC-link capacitance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="1E-12" max="1E+308">
            <value><![CDATA[10.00000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[AFE DC-link capacitance in per unit.]]></help>
          </parameter>
          <parameter name="l_afe_pu" desc="AFE filter inductance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="1E-12" max="1E+308">
            <value><![CDATA[0.05000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[AFE plant and current-loop inductance in per unit.]]></help>
          </parameter>
          <parameter name="r_afe_pu" desc="AFE filter resistance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value>0.00300</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[AFE plant and current-loop resistance in per unit.]]></help>
          </parameter>
        </category>
        <category name="Bandwidth PI Tuning" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="fbw_pll_afe" desc="AFE PLL bandwidth" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[15]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target PLL bandwidth.]]></help>
          </parameter>
          <parameter name="zt_pll_afe" desc="AFE PLL damping ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target PLL damping ratio.]]></help>
          </parameter>
          <parameter name="fbw_c_afe" desc="AFE current-loop bandwidth" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[400]]></value>
            <cond><![CDATA[true]]></cond>
