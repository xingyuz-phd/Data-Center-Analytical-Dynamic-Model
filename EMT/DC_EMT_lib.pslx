      <form name="Average Inverter model" splitter="60" w="500" h="400" commentlines="4" help-width="490" category-width="180">
        <category name="Base Values and Per-Unit Plant" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="Vbase" desc="AC voltage base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="kV" min="1E-12" max="1E+308">
            <value>0.48000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Line-to-line RMS voltage base used for per-unit conversion.]]></help>
          </parameter>
          <parameter name="Sbase" desc="Power base" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="MVA" min="1E-12" max="1E+308">
            <value><![CDATA[1.50000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Power base used for per-unit conversion.]]></help>
          </parameter>
          <parameter name="Fbase" desc="Base frequency" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value>60.00000</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Base frequency; wb = 2*pi*Fbase.]]></help>
          </parameter>
          <parameter name="c_vsi_pu" desc="VSI filter capacitance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="1E-12" max="1E+308">
            <value><![CDATA[1.000]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[VSI plant and voltage-loop capacitance in per unit.]]></help>
          </parameter>
          <parameter name="r_vsi_pu" desc="VSI filter resistance" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="pu" min="0" max="1E+308">
            <value>0.00300</value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[VSI plant and current-loop resistance in per unit.]]></help>
          </parameter>
        </category>
        <category name="Bandwidth PI Tuning" visible="true" splitter="68">
          <cond><![CDATA[true]]></cond>
          <parameter name="fbw_v_vsi" desc="VSI voltage-loop bandwidth" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[100]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target closed-loop bandwidth.]]></help>
          </parameter>
          <parameter name="zt_v_vsi" desc="VSI voltage-loop damping ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target damping ratio.]]></help>
          </parameter>
          <parameter name="fbw_pa_vsi" desc="VSI phase-alignment bandwidth" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="Hz" min="1E-12" max="1E+308">
            <value><![CDATA[0.5]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target closed-loop bandwidth.]]></help>
          </parameter>
          <parameter name="zt_pa_vsi" desc="VSI phase-alignment damping ratio" type="Real" group="" helpmode="Append" content_type="Variable" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[Target damping ratio.]]></help>
          </parameter>
        </category>
      </form>
